# Dependencies (keep package-lock.json in Git)
node_modules/

# Local Python environment and bytecode
.venv/
__pycache__/
*.py[cod]

# Next.js build output and generated types
/.next/
/out/
/next-env.d.ts

# Build output and caches
/build/
/dist/
/.cache/
.eslintcache
*.tsbuildinfo

# Test coverage and browser test artifacts
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/

# Logs and diagnostic reports
*.log
*.log.*
/report.*.json

# Local environment files (keep example templates in Git)
.env*
!.env.example
!.env.*.example
!.env.sample
*.pem
*.key

# Local deployment metadata
/.vercel/

# IDE settings (allow shared VS Code configuration)
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
*.suo
*.user
*.swp
*.swo
*~

# Operating system files
.DS_Store
._*
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Temporary files
/tmp/
/temp/
*.tmp
*.temp

# Keep public/labs/, public/images/, report content and project docs in Git.
